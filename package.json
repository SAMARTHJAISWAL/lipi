{
  "name": "lipi",
  "version": "1.0.0",
  "private": true,
  "description": "A small programming language that compiles to WebAssembly in your browser, with every stage of the compiler on screen.",
  "license": "MIT",
  "author": "Samarth Jaiswal",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0"
  }
}
